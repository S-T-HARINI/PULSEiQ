# PULSEiQ Backend Environment Configuration
PROJECT_NAME="PULSEiQ Backend"
API_V1_PREFIX="/api/v1"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Real-time WebSocket Telemetry Configuration
TELEMETRY_INTERVAL_SECONDS=2.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Configuration (Prepared for future DB layer)
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/pulseiq_db"

# Optional AI / LLM Configuration (Prepared for future AI Assistant integration)
OPENAI_API_KEY=""
